{
  "name": "aboda-soundbot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file=.env src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.ts",
    "ytdlp:install": "node --disable-warning=ExperimentalWarning scripts/install-ytdlp.ts install",
    "ytdlp:check": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/install-ytdlp.ts check",
    "ytdlp:update": "node --disable-warning=ExperimentalWarning scripts/install-ytdlp.ts update"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "opusscript": "^0.0.8"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
