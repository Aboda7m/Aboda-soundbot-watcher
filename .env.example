# Required
DISCORD_TOKEN=your-bot-token

# ---- PUBLIC dashboard (the Cloudflare Tunnel origin): Discord sign-in only ----
PORT=3939
# Bind address of the tunnel origin. Keep 127.0.0.1: cloudflared runs on this PC and connects to it. (The old HOST variable is
# only honored for loopback values; an old HOST=0.0.0.0 is ignored. Remove it from your .env.)
# PUBLIC_HOST=127.0.0.1
# What the browser sees (no trailing path). The OAuth redirect is PUBLIC_BASE_URL/auth/callback; add it in the Developer Portal.
PUBLIC_BASE_URL=https://your-hostname.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Who may sign in. With neither of these set, nobody can.
DASHBOARD_ALLOWED_USER_IDS=
# Or: members of this server (the bot must be in it), optionally only those with one of these role ids
DASHBOARD_GUILD_ID=
DASHBOARD_ROLE_IDS=
# Hours a sign-in lasts (absolute; restarting the bot also signs everyone out)
SESSION_MAX_HOURS=12
# Minutes between re-checks of live sessions against the allow-list / guild / roles (0 = never)
SESSION_RECHECK_MINUTES=10

# ---- LOCAL integration API: access key in an X-Access-Key header, playback/voice routes only ----
# Starts only when a key is set. Never put this port in the Cloudflare Tunnel. See README "Network layout".
# LOCAL_ACCESS_KEY=long-random-value
# Your old ACCESS_KEY still works here (as the local key) but is never accepted by the public dashboard.
# ACCESS_KEY=
# 127.0.0.1 = this PC only. For a LAN device use ONE specific LAN address (never 0.0.0.0) and add the firewall rule from the README.
LOCAL_HOST=127.0.0.1
LOCAL_PORT=3940
# LOCAL_ENABLED=0 turns the local API off even when a key is set
HIDE_BOTS=0

# Sounds (point these at your existing legacy data; nothing is moved or deleted)
SOUNDS_DIR=./sounds
DB_PATH=./db.json
ACCEPTED_EXTENSIONS=.mp3,.wav

# Behaviour
INTROS_ENABLED=1
INTRO_COOLDOWN_MS=3000
MAX_QUEUE_PER_GUILD=10
# Stay in the voice channel this long after the last sound (0 = leave immediately, like the legacy bot)
IDLE_LEAVE_MS=5000
# 1 = keep the legacy per-sound play counter in db.json
COUNT_PLAYS=1

# Text command prefix: people type  !sound "name"  (needs the Message Content intent enabled in the Developer Portal)
COMMAND_PREFIX=!

# Media import page: PUBLIC_BASE_URL/import  (needs ffmpeg + ffprobe on PATH; Discord sign-in like the rest of the dashboard)
# Accepts audio and video files (MP4, MOV, MKV, WebM, M4A, MP3, WAV, OGG/Opus, FLAC, AAC, ...); only the audio is kept.
IMPORT_ENABLED=1
# Biggest upload (the original file, e.g. a video)
IMPORT_MAX_UPLOAD_MB=100
# By default only the first N seconds are kept; the user can pick a custom range or "Full audio"
IMPORT_DEFAULT_TRIM_SEC=10
# Longest sound that can be saved (custom range or Full audio) and biggest saved file
IMPORT_MAX_OUTPUT_SEC=600
IMPORT_MAX_OUTPUT_MB=64
# Upper bound for one FFmpeg run (the real timeout is shorter for short selections)
IMPORT_PROCESS_TIMEOUT_SEC=120
# Only needed if ffmpeg/ffprobe are not on PATH (playback itself always uses the ffmpeg on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Portable yt-dlp lives in tools/yt-dlp/bin (npm run ytdlp:install). Only set this to use a different executable.
YTDLP_PATH=
